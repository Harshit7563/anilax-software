# PostgreSQL (local — run: npm run db:setup)
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/anilax_software

# API server
API_PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Frontend (optional — leave empty to use Vite proxy in dev)
# VITE_API_URL=http://localhost:3001

# Admin panel (/admin) — use a long random password
ADMIN_PASSWORD=change-me-to-a-strong-secret

# Production (Hostinger VPS): see deploy/HOSTINGER-VPS.md
# NODE_ENV=production
# API_HOST=127.0.0.1
# CORS_ORIGINS=https://yourdomain.com
