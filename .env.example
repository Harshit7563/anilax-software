# WhatsApp delivery for the contact form (server-side; does not open WhatsApp in the browser)
# meta = official Business API | greenapi | callmebot | webhook

WHATSAPP_PROVIDER=meta
WHATSAPP_TO=918118898370

# --- Meta WhatsApp Cloud API ---
# Setup: https://developers.facebook.com/ → App → WhatsApp → API Setup
# Copy from the dashboard:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional template with 3 body vars: {{1}} name {{2}} email {{3}} message
# WHATSAPP_TEMPLATE_NAME=anilax_enquiry
# WHATSAPP_TEMPLATE_LANG=en_US

# --- GREEN-API (links a WhatsApp device) ---
# GREEN_API_URL=
# GREEN_API_ID_INSTANCE=
# GREEN_API_TOKEN_INSTANCE=

# --- CallMeBot / webhook ---
# CALLMEBOT_APIKEY=
# CONTACT_WEBHOOK_URL=
